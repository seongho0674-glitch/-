{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "regions": [
    "sin1"
  ],
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__p=$1"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "{server.py,class-roster.json}",
      "excludeFiles": "{public/**,assets/**,css/**,js/**,tests/**,data/**,backup_*/**,qa/**,__pycache__/**,.github/**,*.md,*.bat,*.ps1}"
    }
  },
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
